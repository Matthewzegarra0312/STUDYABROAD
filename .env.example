# Copia este archivo a `.env` y completa los valores. Nunca subas `.env`
# (ya está en .gitignore).

# Clave para el HMAC de los códigos de canje y para firmar la cookie de
# sesión de /mi-calendario (PLAN.md, sección 2). Genera una cadena larga
# y aleatoria, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CANJE_SECRET=

# Upstash Redis (Vercel: Storage -> Marketplace -> Upstash). Si faltan
# estas dos variables, el canje funciona sin límite de dispositivos ni de
# intentos fallidos, y lo avisa en la consola del servidor.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Deja el canje activo sin importar la fecha real, para probarlo antes del
# 10 de octubre (por ejemplo el ensayo del 6 de octubre, PLAN.md sección
# 6, o pruebas locales). Nunca funciona en Vercel (VERCEL siempre está
# puesto ahí), así que no hay riesgo de que quede activado en producción.
# Déjala vacía o en false el resto del tiempo.
CANJE_FORZAR_ACTIVO=

# Dominio final del sitio, sin barra al final (p. ej. https://studyabroadfest.pe).
# Lo usa `npm run codigos` para armar la URL de cada QR si no se pasa
# --base-url explícitamente, y astro.config.mjs (`site`) para las URL
# absolutas de canonical y Open Graph (Fase 6). Sin esta variable, esas
# URL quedan relativas en vez de inventar un dominio. Pendiente (PLAN.md,
# sección 8).
SITE_URL=
