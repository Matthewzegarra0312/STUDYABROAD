---
// Estática (prerender). El generador del badge corre en el navegador
// (BadgeStudio, tarea 5); la subida y /b/[id] son las únicas piezas de servidor.
// Referencia visual: docs/badge-diseno/Main.dc.html y Mobile-Badge.dc.html.
import "@fontsource/arvo/400.css";
import Base from "../layouts/Base.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import BadgeStudio from "../components/badge/BadgeStudio.astro";
import { badgeHref } from "../data/site";
import cieloDesktop from "../assets/marca/hero-cielo-desktop.jpg";
import cieloMobile from "../assets/marca/hero-cielo-mobile.jpg";
---

<Base
  title="Crea tu badge · Study Abroad Fest 2026"
  description="Sube tu foto, escribe tu nombre y cuéntale a tu red en LinkedIn que vas a Study Abroad Fest. Sábado 10 de octubre, Lima."
  image="/og-badge.jpg"
>
  <SiteNav current={badgeHref} />
  <main class="relative overflow-hidden bg-[linear-gradient(180deg,#3B99D8_0%,#66B3EA_87%,#64ABE0_100%)]">
    <picture class="pointer-events-none absolute inset-0 block" aria-hidden="true">
      <source media="(min-width: 1024px)" srcset={cieloDesktop.src} />
      <img src={cieloMobile.src} alt="" width={cieloMobile.width} height={cieloMobile.height} class="size-full object-cover" loading="eager" fetchpriority="low" />
    </picture>
    <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(90deg,rgb(47_134_196/0.62)_0%,rgb(47_134_196/0.4)_45%,rgb(47_134_196/0.12)_85%)]" aria-hidden="true"></div>

    <section id="badge" class="relative mx-auto w-full max-w-[1200px] px-5 pt-28 pb-24 lg:px-10 lg:pt-[140px] lg:pb-[170px]">
      <BadgeStudio>
        <div class="flex min-w-0 flex-col gap-5 lg:gap-[22px]">
          <h1 class="m-0 font-display text-[56px] leading-[.96] font-normal text-paper [text-shadow:0_6px_0_rgb(29_33_82/0.22)] sm:text-[72px] lg:text-[92px]">
            Crea tu<br />
            <span class="mt-3.5 inline-block -rotate-[2.5deg] rounded-2xl border-[5px] border-paper bg-brand-gradient px-6 pt-1 text-[44px] tracking-[.08em] shadow-[0_6px_0_rgb(29_33_82/0.16),0_14px_28px_-12px_rgb(29_33_82/0.35)] [text-shadow:none] sm:text-[52px] lg:border-[6px] lg:px-[34px] lg:text-[64px]">BADGE</span>
          </h1>
          <p class="m-0 max-w-[32ch] text-lg leading-snug font-bold text-paper [text-shadow:0_2px_10px_rgb(29_33_82/0.35)] lg:text-[22px]">
            Sube tu foto, escribe tu nombre y cuéntale a tu red en LinkedIn que vas a Study Abroad Fest.
          </p>
        </div>
      </BadgeStudio>
    </section>
  </main>
  <SiteFooter current={badgeHref} />
  {/* Reserva el espacio de la barra de acciones fija en celular. */}
  <div class="h-[76px] lg:hidden" aria-hidden="true"></div>
</Base>
