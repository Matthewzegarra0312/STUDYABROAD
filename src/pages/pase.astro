---
// /pase: pase de abordaje personal (saf-pases). UNA página prerenderizada; el
// build (scripts/rutas-pase.mjs) agrega la regla que sirve esta misma página
// para /pase/<codigo>. El código se lee y se valida en el navegador
// (src/lib/pase-cliente.ts) y nunca llega a un servidor: los datos vienen
// cifrados en public/pases/<id>.json. Sin analítica en esta página, noindex y
// sin referrer. Diseño: design/pasaporte/Pase.dc.html, PaseForm.dc.html y
// DeskPase.dc.html.
import Base from "../layouts/Base.astro";
import CanjeNav from "../components/canje/CanjeNav.astro";
import SelloStand from "../components/pasaporte/SelloStand.astro";
import evento from "../data/evento";
import { gates } from "../data/schedule";
import cielo from "../assets/marca/hero-cielo-mobile.jpg";

const mono = "font-mono font-semibold";
const flecha = (c: string) => `<svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="${c}" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const avion = (c: string) => `<svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" style="transform:rotate(90deg)"><path d="M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z" fill="${c}"/></svg>`;
const sombraBoleto = "[filter:drop-shadow(0_8px_0_rgb(8_10_45/0.28))_drop-shadow(0_22px_22px_rgb(8_10_45/0.35))]";
---

<Base
  title="Tu pase de abordaje · Study Abroad Fest"
  description="Ingresa el código de tu correo para ver y descargar tu pase de abordaje."
  noindex
  analytics={false}
>
  <meta slot="head" name="referrer" content="no-referrer" />
  <div class="pase-cielo min-h-screen overflow-hidden text-paper" style={`--cielo:url(${cielo.src})`}>
    <CanjeNav current="pase" />
    <main id="pase-raiz" class="relative mx-auto flex w-full max-w-[560px] flex-col gap-5 px-4 pt-3 pb-8 lg:max-w-[1120px] lg:gap-[30px] lg:px-6 lg:pt-11 lg:pb-14">
      <header class="flex flex-col gap-2 px-1 lg:gap-2.5 lg:px-0">
        <span class={`${mono} inline-flex w-fit items-center gap-2 rounded-full bg-ink/40 px-3.5 py-[7px] text-xs tracking-[.14em] uppercase`}>
          <span id="pase-chip-punto" class="pase-pulso hidden size-[9px] rounded-full bg-yellow"></span><span id="pase-chip">CHECK-IN · SAF 2026</span>
        </span>
        <h1 class="m-0 font-display text-[46px] leading-[.94] font-normal [text-shadow:0_4px_0_rgb(29_33_82/0.25)] lg:text-[72px] lg:[text-shadow:0_5px_0_rgb(29_33_82/0.25)]">Tu pase de abordaje</h1>
        <p id="pase-bajada" class="m-0 text-[17px] leading-[1.35] font-bold [text-shadow:0_1px_8px_rgb(29_33_82/0.35)] lg:max-w-[40ch] lg:text-[21px]">
          Escribe el código que llegó a tu correo para ver tu pase y descargarlo.
        </p>
      </header>

      <!-- Código: el mostrador de check-in -->
      <form id="pase-form" hidden class={`flex w-full max-w-[560px] flex-col ${sombraBoleto}`} novalidate>
        <div class="ticket-top flex flex-col gap-3 rounded-t-[22px] bg-paper px-[18px] pt-[18px] pb-[26px] text-ink">
          <div class="flex items-center justify-between">
            <span class={`${mono} text-[11px] tracking-[.14em] text-violet`}>MOSTRADOR DE CHECK-IN</span>
            <Fragment set:html={avion("#AC0BAD")} />
          </div>
          <label for="pase-codigo" class={`${mono} text-[11px] tracking-[.14em] text-ink-2`}>TU CÓDIGO</label>
          <input
            id="pase-codigo"
            name="codigo"
            placeholder="XXXXX-XXXXX"
            autocomplete="off"
            autocapitalize="characters"
            spellcheck="false"
            inputmode="text"
            aria-describedby="pase-error pase-ayuda"
            class="w-full rounded-[14px] border-[2.5px] border-lav bg-paper-2 p-3.5 text-center font-mono text-2xl font-semibold tracking-[.16em] text-ink uppercase placeholder:text-ink-2/50 focus:border-violet focus:ring-4 focus:ring-violet/20 focus:outline-none"
          />
          <span id="pase-ayuda" class="text-[13.5px] leading-[1.35] font-bold text-ink-2">Son 10 caracteres, sin importar mayúsculas ni guiones.</span>
          <div id="pase-error" role="alert" hidden class="flex items-start gap-2.5 rounded-2xl bg-paper-2 px-3.5 py-3 text-sm leading-[1.35] font-bold text-ink">
            <span class="grid size-[26px] shrink-0 place-items-center rounded-full bg-magenta text-[15px] font-black text-paper" aria-hidden="true">!</span>
            <span>No encontramos un pase con ese código. Revisa que esté completo, con el formato XXXXX-XXXXX, y vuelve a intentarlo.</span>
          </div>
        </div>
        <div class="ticket-stub relative rounded-b-[22px] bg-brand-gradient px-[18px] pt-[22px] pb-[18px]">
          <div class="absolute inset-x-[18px] top-0 border-t-[3px] border-dashed border-paper/85"></div>
          <button type="submit" class="btn-lift flex min-h-14 w-full items-center justify-center gap-2.5 rounded-full bg-paper font-display text-[22px] text-ink shadow-[0_5px_0_rgb(8_10_45/0.25)] disabled:opacity-70">
            Ver mi pase <Fragment set:html={flecha("#6258BB")} />
          </button>
        </div>
      </form>

      <div id="pase-estado" hidden role="status" class="rounded-[20px] border-2 border-paper/40 bg-ink/55 p-5 text-center text-lg font-extrabold">
        Validando tu código…
      </div>

      <!-- Pase -->
      <section id="pase-vista" hidden aria-label="Tu pase de abordaje" class="flex flex-col gap-4 lg:flex-row lg:flex-wrap lg:items-start lg:gap-9">
        <div class="flex w-full max-w-[375px] flex-col gap-4 self-center lg:self-start">
          <div id="pase-contenedor" class="w-full"></div>
          <div class="grid grid-cols-2 gap-2.5">
            <button
              id="pase-descargar"
              type="button"
              class="btn-lift flex min-h-[52px] items-center justify-center gap-2 rounded-full bg-paper text-[15.5px] font-extrabold text-ink shadow-[0_5px_0_rgb(8_10_45/0.25)] disabled:opacity-70"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M7 10.5l5 5 5-5M5 20h14" fill="none" stroke="#6258BB" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
              Descargar
            </button>
            <a
              href="/evento.ics"
              download
              class="btn-lift box-border flex min-h-[52px] items-center justify-center gap-2 rounded-full border-[3px] border-paper text-[15.5px] font-extrabold text-paper"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5.5" width="16" height="14" rx="2.5" fill="none" stroke="#FDFEFC" stroke-width="2.4" /><path d="M4 10h16M8.5 3.5v4M15.5 3.5v4" fill="none" stroke="#FDFEFC" stroke-width="2.4" stroke-linecap="round" /></svg>
              A mi calendario
            </a>
          </div>
        </div>

        <div class="flex flex-col gap-4 lg:max-w-[360px] lg:flex-1 lg:basis-[320px]">
          <aside aria-labelledby="pase-pasaporte-titulo" class="relative mt-2 flex -rotate-1 flex-col gap-3 rounded-3xl border-[5px] border-paper bg-paper p-4 pt-[18px] text-ink shadow-[0_8px_0_rgb(8_10_45/0.25),0_20px_30px_-14px_rgb(8_10_45/0.55)] lg:rotate-[1.2deg] lg:gap-3.5 lg:p-5">
            <span class={`${mono} absolute -top-3.5 right-[18px] rotate-3 rounded-full bg-yellow px-3 py-[5px] text-[11px] tracking-[.16em] text-ink shadow-[0_3px_0_rgb(8_10_45/0.25)]`}>NUEVO</span>
            <div class="flex flex-col gap-1">
              <span class={`${mono} text-[11px] tracking-[.16em] text-violet`}>PASAPORTE SAF 2026</span>
              <h2 id="pase-pasaporte-titulo" class="m-0 font-display text-[30px] leading-none font-normal lg:text-[32px]">Tu pasaporte digital</h2>
              <p class="m-0 text-[15px] leading-[1.4] font-semibold text-ink-2">
                El sábado, escanea el QR de cada puerta y junta los {gates.length} sellos. Con tu pasaporte completo recibes el código del Calendario de becas.
              </p>
            </div>
            <div class="grid grid-cols-4 justify-items-center gap-1.5 rounded-2xl bg-paper-2 px-1 py-2.5">
              {gates.map((g) => <SelloStand stand={g.standId} estado="pendiente" size={64} />)}
            </div>
            <button id="pase-abrir-pasaporte" type="button" class="btn-lift flex min-h-14 items-center justify-center gap-2.5 rounded-full border-4 border-paper bg-brand-gradient font-display text-[21px] text-paper shadow-[0_5px_0_rgb(29_33_82/0.2)]">
              Abrir mi pasaporte <Fragment set:html={flecha("#FDFEFC")} />
            </button>
          </aside>

          <a
            href={evento.mapaUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 rounded-[18px] border-2 border-paper/30 bg-[rgb(18_22_74/0.42)] px-3.5 py-3 text-paper lg:hidden"
          >
            <span class="grid size-[42px] shrink-0 place-items-center rounded-xl bg-yellow">
              <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-6.5-6.2-6.5-11a6.5 6.5 0 0 1 13 0c0 4.8-6.5 11-6.5 11z" fill="none" stroke="#1D2152" stroke-width="2.4" stroke-linejoin="round" /><circle cx="12" cy="10" r="2.4" fill="#1D2152" /></svg>
            </span>
            <span class="flex grow flex-col gap-px">
              <span class="text-[15px] font-extrabold">{evento.lugar}</span>
              <span class={`${mono} text-[11px] tracking-[.08em] text-paper/85`}>CÓMO LLEGAR · VER MAPA ↗</span>
            </span>
          </a>

          <button id="pase-otro" type="button" class="inline-flex min-h-11 items-center self-center text-[15px] font-extrabold text-paper underline underline-offset-[3px] lg:self-start">
            Ingresar otro código
          </button>
        </div>
      </section>

      <noscript>
        <p class="rounded-[20px] bg-ink/55 p-5 text-center font-bold">Para ver tu pase necesitas activar JavaScript.</p>
      </noscript>
    </main>
  </div>
</Base>

<style is:global>
  /* El pase usa Lilita One con peso 400: aquí la fuente sí está, así que no se
     simula una negrita encima. */
  .saf-pase,
  .saf-pase * {
    font-synthesis: none;
  }
  .pase-cielo {
    background:
      var(--cielo) center top / 100% auto no-repeat,
      linear-gradient(180deg, #3b99d8 0%, #66b3ea 30%, #6258bb 72%, #4a3f96 100%);
  }
  @media (min-width: 1024px) {
    .pase-cielo {
      background:
        var(--cielo) center top / cover no-repeat,
        linear-gradient(180deg, #3b99d8 0%, #66b3ea 40%, #6258bb 100%);
    }
  }
  .pase-ticket {
    filter: drop-shadow(0 8px 0 rgb(8 10 45 / 0.28)) drop-shadow(0 22px 22px rgb(8 10 45 / 0.35));
  }
  /* Muescas de boleto: círculos recortados en el borde entre el cuerpo y el talón. */
  .ticket-top {
    -webkit-mask:
      radial-gradient(circle 15px at 0 100%, transparent 96%, #000 100%) left / 51% 100% no-repeat,
      radial-gradient(circle 15px at 100% 100%, transparent 96%, #000 100%) right / 51% 100% no-repeat;
    mask:
      radial-gradient(circle 15px at 0 100%, transparent 96%, #000 100%) left / 51% 100% no-repeat,
      radial-gradient(circle 15px at 100% 100%, transparent 96%, #000 100%) right / 51% 100% no-repeat;
  }
  .ticket-stub {
    -webkit-mask:
      radial-gradient(circle 15px at 0 0, transparent 96%, #000 100%) left / 51% 100% no-repeat,
      radial-gradient(circle 15px at 100% 0, transparent 96%, #000 100%) right / 51% 100% no-repeat;
    mask:
      radial-gradient(circle 15px at 0 0, transparent 96%, #000 100%) left / 51% 100% no-repeat,
      radial-gradient(circle 15px at 100% 0, transparent 96%, #000 100%) right / 51% 100% no-repeat;
  }
  @keyframes pase-pulso {
    0%, 100% { box-shadow: 0 0 0 0 rgb(255 227 107 / 0.7); }
    50% { box-shadow: 0 0 0 7px rgb(255 227 107 / 0); }
  }
  .pase-pulso { animation: pase-pulso 2s ease-in-out infinite; }
  @media (prefers-reduced-motion: reduce) {
    .pase-pulso { animation: none; }
  }

  /* Imagen que se descarga (src/lib/pase-descarga.ts): el pase sobre el cielo, con
     el mismo fondo que tenía el pase del correo. Vive fuera de pantalla. */
  .saf-captura {
    box-sizing: border-box;
    width: 375px;
    padding: 22px 14px;
    border-radius: 18px;
    background: #3f8fcb url("/pase-assets/fondo.jpg") center top / cover no-repeat;
  }
  /* WebKit no pinta bien filtros ni máscaras dentro de foreignObject: en la
     imagen se omiten (sin sombra ni muescas) para que nunca salga en blanco. */
  .saf-captura-simple .pase-ticket {
    filter: none;
  }
  .saf-captura-simple .ticket-top,
  .saf-captura-simple .ticket-stub {
    -webkit-mask: none;
    mask: none;
  }
</style>

<script>
  import { armarPagina } from "../lib/pase-cliente";
  armarPagina();
</script>
