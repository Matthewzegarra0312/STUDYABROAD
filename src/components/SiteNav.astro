---
// Navbar flotante estilo LEAD UTP (VIAJE.md, sección 3). Pastilla de 60 px,
// fondo navy translúcido. Mobile: CTA compacto + menú con foco atrapado.
import { Image } from "astro:assets";
import { lumaUrl } from "../lib/luma";
import { navLinks } from "../data/site";
import { enlaceInicio } from "../lib/enlace";
import logoLead from "../assets/marca/logo-lead.png";
import logoEvento from "../assets/marca/logo study.png";

interface Props {
  /** Ruta de la página actual cuando no es la home (p. ej. "/badge"). Los
   *  anclas pasan a "/#ancla" y el enlace de esa ruta queda como activo. */
  current?: string;
}

const { current } = Astro.props;
const links = navLinks.map((l) => {
  const isAnchor = l.href.startsWith("#");
  return {
    ...l,
    href: isAnchor ? enlaceInicio(l.href, current) : l.href,
    anchor: isAnchor ? l.href : undefined,
    isCurrent: l.href === current,
  };
});

const tagClass =
  "rounded-[4px] bg-[#FFE36B] px-[5px] py-px font-mono text-[9px] leading-snug font-semibold tracking-[.08em] text-navy";

const linkBase =
  "relative inline-flex items-center gap-1.5 whitespace-nowrap rounded-md px-2.5 py-2 font-inter text-[13.44px] leading-tight transition-colors duration-200";
---

<header class="pointer-events-none fixed inset-x-0 top-3 z-50 px-3 lg:top-5 lg:px-6" data-site-nav>
  <div
    class="pointer-events-auto relative mx-auto flex h-[60px] w-full max-w-[1120px] items-center justify-between rounded-xl lg:grid lg:grid-cols-[1fr_auto_1fr] border border-border-light bg-[rgb(2_12_62/0.78)] pr-2 pl-3.5 text-white shadow-[0_8px_30px_-12px_rgb(2_12_62/0.6)] backdrop-blur-[8px] backdrop-saturate-[1.3] lg:pr-3 lg:pl-5"
  >
    <a href={enlaceInicio("#hero", current)} aria-label="LEAD UTP, Study Abroad Fest, inicio" class="inline-flex min-h-11 items-center gap-[7px] rounded-md max-[374px]:gap-1.5 lg:gap-3 lg:justify-self-start">
      <Image src={logoLead} alt="" width={102} height={40} widths={[84, 102, 204]} sizes="(min-width: 1024px) 102px, 84px" class="block h-auto w-[84px] max-[374px]:w-[62px] lg:w-[102px]" loading="eager" />
      <span class="h-[22px] w-px bg-white/22 lg:h-[26px]" aria-hidden="true"></span>
      <Image src={logoEvento} alt="Study Abroad Fest" width={1080} height={1350} class="block h-[46px] w-auto object-contain max-[374px]:h-10 lg:h-[50px]" loading="eager" />
    </a>

    <nav aria-label="Navegación principal" class="hidden items-center gap-0.5 lg:flex">
      {links.map((l) => (
        <a
          href={l.href}
          data-nav-link
          data-nav-anchor={l.anchor}
          aria-current={l.isCurrent ? "page" : undefined}
          class={`${linkBase} font-medium text-white/80 hover:bg-white/6 hover:text-white aria-[current]:bg-white/8 aria-[current]:font-semibold aria-[current]:text-white`}
        >
          {l.label}{l.tag && <span class={tagClass}>{l.tag}</span>}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-1 lg:justify-self-end">
      <a
        href={lumaUrl("nav")}
        class="inline-flex min-h-11 items-center justify-center rounded-md bg-white px-3 font-archivo text-[12.5px] font-extrabold tracking-[.005em] whitespace-nowrap text-navy transition-colors duration-200 hover:bg-magenta hover:text-white lg:px-4 lg:text-[13px]"
      >
        <span class="lg:hidden">Inscríbete</span><span class="hidden lg:inline">Inscríbete gratis</span>
      </a>
      <button
        type="button"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="site-menu"
        aria-label="Abrir menú de navegación"
        class="inline-flex size-11 items-center justify-center rounded-md text-white transition-colors hover:bg-white/10 lg:hidden"
      >
        <svg data-icon-open width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
        <svg data-icon-close class="hidden" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </div>

    <div
      id="site-menu"
      hidden
      class="absolute inset-x-0 top-[calc(100%+8px)] rounded-xl border border-border-light bg-[rgb(2_12_62/0.96)] p-2 shadow-2xl backdrop-blur-xl lg:hidden"
    >
      <nav aria-label="Navegación móvil">
        {links.map((l) => (
          <a
            href={l.href}
            aria-current={l.isCurrent ? "page" : undefined}
            class="flex min-h-11 items-center justify-between rounded-md px-4 font-inter text-sm font-semibold text-white/80 transition-colors hover:bg-white/8 hover:text-white aria-[current]:bg-white/8 aria-[current]:text-white"
          >
            {l.label}{l.tag && <span class={`${tagClass} !px-1.5 !py-0.5 !text-[10px]`}>{l.tag}</span>}
          </a>
        ))}
        <a href={lumaUrl("nav-movil")} class="mt-2 flex min-h-11 items-center justify-center rounded-md bg-white px-4 font-archivo text-sm font-extrabold text-navy transition-colors hover:bg-magenta hover:text-white">
          Inscríbete gratis
        </a>
      </nav>
    </div>
  </div>
</header>

<style>
  [data-site-nav] {
    transition: transform 0.28s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  [data-site-nav].nav-hidden {
    transform: translateY(calc(-100% - 24px));
  }

  [data-nav-link]::after {
    content: "";
    position: absolute;
    right: 10px;
    bottom: 4px;
    left: 10px;
    height: 2px;
    border-radius: 999px;
    background: var(--color-active);
    opacity: 0;
    transform: scaleX(0.35);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  [data-nav-link][aria-current]::after {
    opacity: 1;
    transform: scaleX(1);
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-nav]");
  const toggle = header?.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const menu = header?.querySelector<HTMLElement>("#site-menu");

  if (header && toggle && menu) {
    const iconOpen = toggle.querySelector("[data-icon-open]");
    const iconClose = toggle.querySelector("[data-icon-close]");
    const focusables = () =>
      Array.from(header.querySelectorAll<HTMLElement>("#site-menu a, [data-nav-toggle]")).filter(
        (el) => el.offsetParent !== null,
      );

    const setOpen = (open: boolean, returnFocus = false) => {
      menu.hidden = !open;
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Cerrar menú de navegación" : "Abrir menú de navegación");
      iconOpen?.classList.toggle("hidden", open);
      iconClose?.classList.toggle("hidden", !open);
      if (open) menu.querySelector<HTMLElement>("a")?.focus();
      else if (returnFocus) toggle.focus();
    };

    toggle.addEventListener("click", () => setOpen(Boolean(menu.hidden)));
    menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));

    header.addEventListener("keydown", (e) => {
      if (menu.hidden) return;
      if (e.key === "Escape") {
        setOpen(false, true);
        return;
      }
      if (e.key !== "Tab") return;
      // Foco atrapado: primero los enlaces del menú, al final el botón.
      const items = [...focusables().filter((el) => el !== toggle), toggle];
      const first = items[0];
      const last = items[items.length - 1];
      if (!first || !last) return;
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    document.addEventListener("click", (e) => {
      if (!menu.hidden && e.target instanceof Node && !header.contains(e.target)) setOpen(false);
    });
    window.matchMedia("(min-width: 1024px)").addEventListener("change", (e) => {
      if (e.matches) setOpen(false);
    });
  }

  // Enlace activo según la sección visible (aria-current, sin depender del color).
  // La navbar se aparta al bajar y vuelve al llevar el cursor a la franja superior.
  let lastScrollY = window.scrollY;
  let navHidden = false;

  const setNavHidden = (hidden: boolean) => {
    if (navHidden === hidden) return;
    navHidden = hidden;
    header?.classList.toggle("nav-hidden", hidden);
  };

  window.addEventListener(
    "scroll",
    () => {
      const currentScrollY = window.scrollY;
      const scrollingDown = currentScrollY > lastScrollY + 4;

      if (currentScrollY <= 24) setNavHidden(false);
      else if (scrollingDown && currentScrollY > 120) setNavHidden(true);

      lastScrollY = currentScrollY;
    },
    { passive: true },
  );

  document.addEventListener("mousemove", (event) => {
    if (event.clientY <= 88) setNavHidden(false);
  });

  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-nav-anchor]"));
  const targets = links
    .map((a) => ({ a, el: document.querySelector(a.dataset.navAnchor ?? "") }))
    .filter((t): t is { a: HTMLAnchorElement; el: Element } => t.el !== null);
  if ("IntersectionObserver" in window && targets.length) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          targets.forEach((t) => {
            if (t.el === entry.target) t.a.setAttribute("aria-current", "true");
            else t.a.removeAttribute("aria-current");
          });
        }
      },
      { rootMargin: "-40% 0px -55% 0px" },
    );
    targets.forEach((t) => io.observe(t.el));
    // Sobre el hero (despegue) ningún enlace queda activo.
    const hero = document.querySelector("#hero");
    if (hero) {
      new IntersectionObserver(
        ([e]) => {
          if (e?.isIntersecting) targets.forEach((t) => t.a.removeAttribute("aria-current"));
        },
        { rootMargin: "0px 0px -60% 0px" },
      ).observe(hero);
    }
  }
</script>
