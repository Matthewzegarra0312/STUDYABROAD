---
// Footer estilo LEAD UTP (VIAJE.md, sección 3).
import { Image } from "astro:assets";
import { footerColumns, socialLinks, supportItems } from "../data/site";
import logoEvento from "../assets/marca/logo study.png";
import { enlaceInicio } from "../lib/enlace";

interface Props {
  /** Ruta de la página actual cuando no es la home: los anclas pasan a "/#ancla". */
  current?: string;
}

const { current } = Astro.props;
const resolver = (href: string | null) => (href?.startsWith("#") ? enlaceInicio(href, current) : href);

const linkClass =
  "v-flink inline-flex min-h-11 items-center rounded-sm font-inter text-sm text-white/72 lg:min-h-9";
const headingClass = "m-0 font-inter text-[11px] font-semibold tracking-[.14em] text-white/70 uppercase";
const columns = [
  ...footerColumns,
  {
    id: "social",
    title: "Síguenos",
    items: socialLinks.map((s) => ({ label: s.label, href: s.href as string | null })),
  },
  { id: "soporte", title: "Soporte", items: supportItems },
];
---

<footer class="border-t border-border-light bg-footer text-white">
  <div class="mx-auto w-full max-w-[1200px] px-5 lg:px-0">
    <div class="grid gap-9 pt-10 pb-8 lg:grid-cols-[minmax(0,.6fr)_minmax(0,1fr)] lg:items-start lg:gap-20 lg:py-11">
      <div class="max-w-sm">
        <a href={enlaceInicio("#hero", current)} aria-label="Ir al inicio de Study Abroad Fest" class="inline-flex items-center rounded-sm">
          <Image src={logoEvento} alt="Study Abroad Fest" width={1080} height={1350} class="block h-[88px] w-auto object-contain lg:h-24" loading="lazy" />
        </a>
        <p class="mt-3.5 font-inter text-xs leading-6 font-semibold tracking-[.16em] text-white/72 lg:mt-4">LEARN. EXPLORE. ASPIRE. DISCOVER.</p>
        <ul class="mt-[18px] flex items-center gap-2.5 lg:mt-5" aria-label="Redes sociales de LEAD UTP">
          {socialLinks.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={`${s.label} de LEAD UTP (se abre en una pestaña nueva)`} class="v-social inline-flex size-11 items-center justify-center rounded-full border border-white/15 bg-white/6 text-white/80">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  {s.id === "instagram" && (<><rect width="20" height="20" x="2" y="2" rx="5" ry="5" /><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37Z" /><path d="M17.5 6.5h.01" /></>)}
                  {s.id === "linkedin" && (<><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6Z" /><path d="M2 9h4v12H2z" /><circle cx="4" cy="4" r="2" /></>)}
                  {s.id === "discord" && <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" />}
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="grid grid-cols-2 gap-x-5 gap-y-[26px] lg:grid-cols-4 lg:gap-x-8 lg:gap-y-0">
        {columns.map((c) => (
          <nav aria-labelledby={`footer-${c.id}`}>
            <p id={`footer-${c.id}`} class={headingClass}>{c.title}</p>
            <ul class="m-0 mt-2.5 flex list-none flex-col gap-0.5 p-0 lg:mt-3">
              {c.items.map((item) => (
                <li>
                  {item.href ? (
                    <a href={resolver(item.href)!} class={linkClass} target={item.href.startsWith("http") ? "_blank" : undefined} rel={item.href.startsWith("http") ? "noopener noreferrer" : undefined}>
                      {item.label}{item.href.startsWith("http") && <span class="sr-only"> (se abre en una pestaña nueva)</span>}
                    </a>
                  ) : (
                    <span class="inline-flex min-h-11 items-center font-inter text-sm text-white/72 lg:min-h-9">{item.label}</span>
                  )}
                </li>
              ))}
            </ul>
          </nav>
        ))}
      </div>
    </div>
    <div class="flex flex-col gap-1 border-t border-white/10 pt-4 pb-[26px] font-inter text-xs leading-relaxed text-white/62 lg:flex-row lg:items-center lg:justify-between lg:pb-[22px]">
      <span>© 2026 LEAD UTP · Todos los derechos reservados</span>
      <span>Study Abroad Fest · en alianza con UTP Internacional</span>
    </div>
  </div>
</footer>
