---
// "Calendario de becas: se gana en el evento" (design/canvas/Seccion-Landing.dc.html).
// El pasaporte tiene una casilla de sello por cada stand confirmado
// (ahora 4: UTP Internacional, EducationUSA, Study in Japan, Erasmus Mundus).
import stands from "../data/stands";
import { lumaUrl } from "../lib/luma";
import Button from "./ui/Button.astro";
import Sello from "./ui/Sello.astro";

const standsConfirmados = stands.filter((s) => s.estado === "confirmado");

const pasos = [
  { n: 1, titulo: "Recoge tu pasaporte", detalle: "Al ingresar al evento." },
  { n: 2, titulo: "Junta los sellos", detalle: "Uno por cada stand que visites." },
  { n: 3, titulo: "Canjea tu código", detalle: "Y descarga tu calendario aquí." },
];

// #2771A5 en vez de #2F86C4 (sky-deep): sobre el sello, ese azul más claro
// no llega a 4.5:1 de contraste (Fase 6, revisión AA); esta variante más
// oscura sí, y se mantiene en la misma familia de color.
const COLORES_SELLO = ["#6258BB", "#AC0BAD", "#2771A5", "#525F97"];
---

<section id="calendario" class="relative overflow-hidden bg-sky px-4 py-16 text-paper sm:px-8 lg:px-[120px] lg:py-24">
  <div class="cloud-drift pointer-events-none absolute left-14 top-8 hidden h-11 w-40 rounded-full bg-paper/85 lg:block" aria-hidden="true"></div>

  <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_560px] lg:items-center lg:gap-14">
    <div class="flex flex-col gap-5">
      <span class="inline-flex w-fit items-center gap-2 rounded-full bg-ink/35 px-3.5 py-2 font-mono text-[13px] font-semibold uppercase tracking-[.14em]">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FFE36B" stroke-width="2.6" stroke-linecap="round" aria-hidden="true">
          <rect x="5" y="11" width="14" height="10" rx="2"></rect>
          <path d="M8 11V8a4 4 0 0 1 8 0v3"></path>
        </svg>
        Exclusivo para asistentes
      </span>
      <h2 class="m-0 font-display text-4xl leading-none [text-shadow:0_5px_0_rgba(29,33,82,.2)] sm:text-5xl lg:text-[66px]">
        Tu Calendario de becas se gana en el evento
      </h2>
      <p class="m-0 max-w-[40ch] text-xl font-bold leading-snug sm:text-2xl">
        Fechas de cierre, web oficial y tips de cada stand para cada convocatoria. Solo para quienes vienen el 10 de octubre.
      </p>

      <div class="mt-1.5 grid grid-cols-1 gap-3.5 sm:grid-cols-3">
        {pasos.map((p, i) => (
          <div
            class="flex flex-col gap-2 rounded-2xl bg-paper p-4 text-ink shadow-[0_6px_0_rgba(29,33,82,.16)]"
            style={`transform: rotate(${i % 2 === 0 ? "-1.2deg" : "1deg"})`}
          >
            <span class="font-display text-3xl leading-none text-violet">{p.n}</span>
            <b class="text-base">{p.titulo}</b>
            <span class="text-sm text-ink-2">{p.detalle}</span>
          </div>
        ))}
      </div>

      <div class="mt-2 flex flex-wrap items-center gap-3.5">
        <Button href={lumaUrl("calendario")} variant="gradient" size="md">Inscríbete para ir</Button>
        <Button href="/canje" variant="outline" size="md">Ya tengo mi código</Button>
      </div>
    </div>

    <div class="relative mx-auto h-[420px] w-full max-w-[520px] sm:h-[500px]">
      <div class="absolute left-4 top-4 flex w-[86%] -rotate-2 flex-col gap-3.5 rounded-2xl bg-paper p-6 text-ink shadow-[0_10px_0_rgba(29,33,82,.16),0_26px_44px_-16px_rgba(29,33,82,.5)] sm:w-[440px]">
        <div class="flex items-end justify-between">
          <span class="font-display text-2xl">Pasaporte</span>
          <span class="font-mono text-[11px] text-ink-2">SAF 2026</span>
        </div>
        <div class="grid grid-cols-2 gap-3.5 sm:grid-cols-4">
          {standsConfirmados.map((s, i) => (
            <div class="grid aspect-square place-items-center rounded-xl border-[1.5px] border-lav p-1.5">
              <Sello
                shape="circulo"
                size={92}
                color={COLORES_SELLO[i % COLORES_SELLO.length]}
                class={i % 2 === 0 ? "stamp-drop-a" : "stamp-drop-b"}
                rotate={i % 2 === 0 ? "8deg" : "-12deg"}
              >
                {s.nombre}
              </Sello>
            </div>
          ))}
        </div>
      </div>
      <div class="absolute bottom-0 right-0 flex w-[260px] rotate-3 flex-col gap-2 rounded-2xl border-[5px] border-paper bg-brand-gradient p-5 text-paper shadow-[0_8px_0_rgba(29,33,82,.18)] sm:w-[280px]">
        <span class="font-mono text-[11px] uppercase tracking-[.14em]">Tu código</span>
        <span class="font-mono text-2xl font-semibold tracking-[.06em]">SAF-····-····</span>
        <span class="text-sm font-bold">Calendario + tips desbloqueados</span>
      </div>
    </div>
  </div>
</section>
