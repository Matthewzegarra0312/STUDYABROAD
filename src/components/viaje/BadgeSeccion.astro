---
// 05b · Tu pasaporte para LinkedIn. Entrada a /badge desde la home, entre el
// Pasaporte (#calendario) y Cómo llegar (#llegar). Solo para asistentes.
// Referencia: docs/badge-diseno/Home-Seccion-Desktop.dc.html y -Mobile.dc.html.
import { pasosBadge } from "../../data/badge";
import { badgeHref } from "../../data/site";
import Cta from "./Cta.astro";

const rot = ["-rotate-[1.2deg]", "rotate-1", "-rotate-[.8deg]"];
---

<section id="badge" class="relative scroll-mt-24 pt-[50px] pb-14 text-paper lg:pt-[90px] lg:pb-[90px]" aria-labelledby="badge-title">
  <div class="mx-auto grid w-full max-w-[1200px] items-center gap-8 px-5 md:px-8 lg:grid-cols-2 lg:gap-[70px] lg:px-10 xl:px-0">
    <div class="flex flex-col gap-4 lg:gap-[22px]" data-motion-stop data-motion-delay="0">
      <span class="inline-flex items-center self-start rounded-full bg-paper/14 px-3 py-[7px] font-mono text-[11px] font-semibold tracking-[.12em] uppercase lg:gap-2 lg:px-3.5 lg:py-2 lg:text-[13px] lg:tracking-[.14em]">
        <svg class="hidden size-3.5 lg:block lg:size-4" viewBox="0 0 24 24" fill="none" stroke="#FFE36B" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l2.6 5.6 6 .7-4.5 4.1 1.2 6L12 16.4 6.7 19.4l1.2-6L3.4 9.3l6-.7z"></path></svg>
        Nuevo · Para asistentes
      </span>
      <h2 id="badge-title" class="m-0 font-display text-[46px] leading-none font-normal [text-shadow:0_4px_0_rgb(29_33_82/0.22)] lg:text-[70px] lg:[text-shadow:0_5px_0_rgb(29_33_82/0.22)]">Tu pasaporte para LinkedIn</h2>
      <p class="m-0 max-w-[40ch] text-lg leading-[1.4] font-bold text-paper/92 lg:text-[21px]">
        Crea tu badge con tu foto y tu nombre, y cuéntale a tu red que vas<span class="hidden lg:inline"> a Study Abroad Fest</span>.
      </p>
      <ol class="m-0 hidden list-none gap-3.5 p-0 lg:mt-1.5 lg:grid lg:grid-cols-3">
        {pasosBadge.map((s, i) => (
          <li class={`flex flex-col gap-2 rounded-[18px] bg-paper p-[18px] text-ink shadow-[0_6px_0_rgb(8_10_45/0.3)] ${rot[i]}`}>
            <span class="font-display text-[30px] leading-none text-violet" aria-hidden="true">{i + 1}</span>
            <b class="text-[17px]">{s.title}</b>
          </li>
        ))}
      </ol>
      <Cta href={badgeHref} class="mt-1 min-h-14 self-stretch px-7 text-xl shadow-[0_5px_0_rgb(8_10_45/0.3)] lg:mt-1.5 lg:min-h-0 lg:self-start lg:pt-[15px] lg:pb-[13px] lg:text-[21px]">
        Crear mi badge
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"></path></svg>
      </Cta>
    </div>

    <div class="flex justify-center" data-motion-stop data-motion-delay="180">
      <div class="v-float w-[min(100%,316px)] overflow-hidden rounded-[20px] border-8 border-paper bg-paper shadow-[0_8px_0_rgb(8_10_45/0.3),0_24px_36px_-14px_rgb(8_10_45/0.6)] lg:w-[380px] lg:rounded-[22px] lg:border-[10px] lg:shadow-[0_10px_0_rgb(8_10_45/0.3),0_30px_48px_-16px_rgb(8_10_45/0.6)]">
        <img src="/badge/plantilla.jpg" alt="Ejemplo del badge de asistente de Study Abroad Fest 2026, con espacio para tu foto, nombre y mood" width="1080" height="1350" class="block h-auto w-full" loading="lazy" decoding="async" />
      </div>
    </div>
  </div>
</section>
