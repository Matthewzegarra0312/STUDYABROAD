---
// 07 · Aterrizaje: CTA final al atardecer, con montañas, pista y un avión
// que aterriza. Todo el fondo es decorativo.
import { getImage } from "astro:assets";
import { lumaUrl } from "../../lib/luma";
import cieloMobile from "../../assets/marca/aterrizaje-cielo-mobile.jpg";
import cieloDesktop from "../../assets/marca/aterrizaje-cielo-desktop.jpg";
import Plane from "./Plane.astro";
import Cta from "./Cta.astro";

const cieloM = await getImage({ src: cieloMobile, format: "webp", quality: 90 });
const cieloD = await getImage({ src: cieloDesktop, format: "webp", quality: 90 });
const PATH_D = "M-60 60 C 300 40, 700 130, 1000 300 S 1300 372, 1500 372";
const PATH_M = "M-40 50 C 80 40, 180 100, 250 240 S 340 292, 430 292";
---

<section class="relative h-[560px] overflow-hidden text-center text-paper lg:h-[600px]" aria-labelledby="aterrizaje-title">
  <div class="pointer-events-none absolute inset-0 [mask-image:linear-gradient(180deg,transparent_0,rgb(0_0_0/0.6)_90px,#000_220px)]" aria-hidden="true">
    <!-- cielo de atardecer -->
    <div
      class="absolute inset-0 bg-cover bg-[position:50%_35%] bg-no-repeat [background-image:var(--cielo-m)] lg:[background-image:var(--cielo-d)]"
      style={`--cielo-m:url(${cieloM.src});--cielo-d:url(${cieloD.src})`}
    ></div>
    <!-- velo violeta: contraste para el título y el botón -->
    <div class="absolute inset-0 bg-[linear-gradient(180deg,rgb(42_36_104/0.5)_0%,rgb(91_42_134/0.3)_50%,rgb(91_42_134/0)_100%)]"></div>
  </div>

  <div class="relative z-10 flex flex-col items-center gap-4 px-5 pt-[70px] lg:gap-[22px] lg:pt-24" data-motion-stop data-motion-delay="0">
    <h2 id="aterrizaje-title" class="m-0 max-w-[16ch] font-display text-[44px] leading-none font-normal [text-shadow:0_4px_0_rgb(29_33_82/0.28)] lg:text-[76px] lg:[text-shadow:0_6px_0_rgb(29_33_82/0.28)]">Tu camino empieza el 10 de octubre</h2>
    <p class="m-0 max-w-[40ch] text-[17px] font-bold [text-shadow:0_2px_10px_rgb(42_36_104/0.7)] lg:text-[22px]">Ven con curiosidad y sal con una oportunidad concreta a la que postular.</p>
    <Cta href={lumaUrl("cta-final")} class="min-h-14 px-7 text-[21px] shadow-[0_5px_0_rgb(29_33_82/0.3)] lg:px-[34px] lg:pt-[18px] lg:pb-4 lg:text-2xl">Inscríbete gratis</Cta>
  </div>

  <div class="pointer-events-none absolute inset-x-0 bottom-0" aria-hidden="true">
    <svg class="block h-[150px] w-full lg:hidden" viewBox="0 0 390 150" preserveAspectRatio="xMidYMax slice">
      <rect x="0" y="124" width="390" height="26" fill="#525F97"></rect>
      <path class="v-dash" d="M0 137 H390" stroke="#FDFEFC" stroke-width="2.5" stroke-linecap="round"></path>
    </svg>
    <svg class="hidden h-[200px] w-full lg:block" viewBox="0 0 1440 200" preserveAspectRatio="xMidYMax slice">
      <rect x="0" y="168" width="1440" height="32" fill="#525F97"></rect>
      <path class="v-dash" d="M0 184 H1440" stroke="#FDFEFC" stroke-width="3" stroke-linecap="round"></path>
    </svg>
  </div>
  <div class="pointer-events-none absolute inset-x-0 bottom-0" aria-hidden="true">
    <svg class="block h-[330px] w-full overflow-visible lg:hidden" viewBox="0 0 390 330" preserveAspectRatio="xMidYMax slice">
      <g class="motion-plane"><Plane scale={1.8} rotate={90} stroke="#1D2152" strokeWidth={0.7} /><animateMotion dur="9s" repeatCount="indefinite" rotate="auto" path={PATH_M}></animateMotion></g>
    </svg>
    <svg class="hidden h-[420px] w-full overflow-visible lg:block" viewBox="0 0 1440 420" preserveAspectRatio="xMidYMax slice">
      <g class="motion-plane"><Plane scale={2.4} rotate={90} stroke="#1D2152" strokeWidth={0.6} /><animateMotion dur="9s" repeatCount="indefinite" rotate="auto" path={PATH_D}></animateMotion></g>
    </svg>
  </div>
</section>
