---
// 06 · Cómo llegar: pase de abordaje con los datos prácticos, más la FAQ.
// Sin aforo ni cifras de capacidad (CLAUDE.md, regla 3).
import evento from "../../data/evento";
import { faq } from "../../data/schedule";
import { fechaEvento, hora12 } from "../../lib/viaje";
import { googleCalendarUrl } from "../../lib/calendario";

const fecha = fechaEvento(evento.fecha);
const mapa = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${evento.lugar} ${evento.direccion}`)}`;
const campos = [
  { k: "Fecha", v: `${fecha.corta} ${fecha.anio}`, span: "" },
  { k: "Tarifa", v: evento.gratuito ? "Gratis" : "Con costo", span: "order-2 lg:order-4" },
  { k: "Embarque", v: hora12(evento.horaInicio), span: "order-3 lg:order-2" },
  { k: "Llegada", v: hora12(evento.horaFin), span: "order-4 lg:order-3" },
  { k: "Puerta", v: `${evento.lugar} · ${evento.direccion}`, span: "order-5 col-span-2 lg:col-span-3" },
  { k: "Requisito", v: evento.inscripcionPrevia ? "Inscripción previa en Luma" : "Ninguno", span: "order-6 col-span-2 lg:col-span-1" },
];
const label = "font-mono text-[11px] font-semibold tracking-[.14em] text-ink-2 uppercase lg:text-xs";
const pill = "flex min-h-12 items-center justify-center gap-2 rounded-full border-[3px] border-violet px-5 text-[15px] font-extrabold text-violet transition-colors hover:bg-violet hover:text-paper lg:min-h-0 lg:py-[11px] lg:text-base";
---

<section id="llegar" class="relative scroll-mt-24 pt-5 pb-16 text-paper lg:pt-[60px] lg:pb-24" aria-labelledby="llegar-title">
  <div class="mx-auto w-full max-w-[1200px] px-5 md:px-8 lg:px-10 xl:px-0">
    <div class="mb-6 flex flex-col gap-3 lg:mb-9 lg:gap-3.5" data-motion-stop data-motion-delay="0">
      <h2 id="llegar-title" class="m-0 font-display text-[50px] leading-none font-normal [text-shadow:0_4px_0_rgb(29_33_82/0.22)] lg:text-[72px] lg:[text-shadow:0_5px_0_rgb(29_33_82/0.22)]">Tu pase de abordaje</h2>
    </div>

    <div class="overflow-hidden rounded-[22px] bg-paper text-ink shadow-[0_8px_0_rgb(8_10_45/0.3),0_22px_34px_-14px_rgb(8_10_45/0.6)] lg:grid lg:grid-cols-[minmax(0,1fr)_240px] lg:rounded-[26px] lg:shadow-[0_10px_0_rgb(8_10_45/0.3),0_26px_44px_-16px_rgb(8_10_45/0.6)]" data-motion-stop data-motion-delay="140">
      <div class="flex flex-col gap-[18px] px-5 py-[22px] lg:gap-[26px] lg:px-10 lg:py-9">
        <div class="flex items-center justify-between border-b-2 border-dashed border-lav pb-3.5 lg:pb-5">
          <span class="font-mono text-[11px] font-semibold tracking-[.12em] text-violet uppercase lg:text-[13px] lg:tracking-[.14em]"><span class="lg:hidden">SAF · 2026</span><span class="hidden lg:inline">Study Abroad Fest · 2026</span></span>
          <span class="flex items-center gap-2 font-display text-[22px] lg:gap-3.5 lg:text-[32px]" aria-hidden="true">LIMA
            <svg class="size-[22px] lg:size-[34px]" viewBox="0 0 24 24"><path fill="#AC0BAD" d="M21.5 15.2v-1.8L13.6 8.5V3.3a1.6 1.6 0 1 0-3.2 0v5.2l-7.9 4.9v1.8l7.9-2.4v5.1l-2 1.5V21l3.6-1 3.6 1v-1.6l-2-1.5v-5.1z" transform="rotate(90 12 12)"></path></svg>
            EL MUNDO</span>
        </div>
        <dl class="m-0 grid grid-cols-2 gap-x-3.5 gap-y-4 lg:grid-cols-4 lg:gap-x-7 lg:gap-y-[22px]">
          {campos.map((c) => (
            <div class={c.span}><dt class={label}>{c.k}</dt><dd class="m-0 text-lg font-extrabold lg:text-[21px]">{c.v}</dd></div>
          ))}
        </dl>
        <div class="flex flex-col gap-2.5 lg:flex-row lg:gap-3">
          <a href={mapa} class={pill} target="_blank" rel="noopener">Cómo llegar ↗<span class="sr-only"> (abre Google Maps)</span></a>
          <a href={googleCalendarUrl()} class={pill} target="_blank" rel="noopener">Agregar a mi calendario<span class="sr-only"> (abre Google Calendar)</span></a>
        </div>
      </div>
      <div class="flex items-center justify-between border-t-[3px] border-dashed border-paper bg-brand-gradient px-5 py-[18px] text-paper lg:flex-col lg:justify-center lg:gap-3.5 lg:border-t-0 lg:border-l-[3px] lg:bg-[linear-gradient(170deg,#AC0BAD,#6258BB)] lg:p-[30px] lg:text-center" aria-hidden="true">
        <div><div class="font-mono text-[11px] font-semibold tracking-[.14em] uppercase lg:text-xs">Asiento</div><div class="font-display text-[40px] leading-[.95] lg:text-[58px] lg:leading-[.9]">Tuyo</div></div>
        <div class="h-[38px] w-[120px] bg-[repeating-linear-gradient(90deg,#FDFEFC_0_2px,transparent_2px_4px,#FDFEFC_4px_7px,transparent_7px_9px,#FDFEFC_9px_10px,transparent_10px_13px)] lg:h-[42px] lg:w-[140px]"></div>
      </div>
    </div>

    <ul class="m-0 mt-8 grid list-none gap-3.5 p-0 lg:mt-11 lg:grid-cols-2 lg:gap-x-6 lg:gap-y-4">
      {faq.filter((f) => f.estado === "confirmado").map((f, i) => (
        <li class="rounded-[18px] bg-paper/96 px-5 py-[18px] text-ink shadow-[0_5px_0_rgb(8_10_45/0.24)] lg:px-6 lg:py-5" data-motion-stop data-motion-delay={`${260 + i * 90}`}>
          <h3 class="m-0 text-[17px] leading-tight font-extrabold lg:text-[19px]">{f.pregunta}</h3>
          <p class="m-0 mt-2 text-[15px] leading-normal font-medium text-ink-2 lg:text-base">{f.respuesta}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
