---
// 01 · Despegue (VIAJE.md, sección 1). Nubes, estela con avión animado,
// key visual flotante, sello postal y cuenta regresiva. Todo lo que rodea
// al texto es decorativo (aria-hidden).
import { Image, getImage } from "astro:assets";
import evento from "../../data/evento";
import { lumaUrl } from "../../lib/luma";
import { fechaEvento, rangoHoras } from "../../lib/viaje";
import keyVisual from "../../assets/marca/key-visual.png";
import cieloMobile from "../../assets/marca/hero-cielo-mobile.jpg";
import cieloDesktop from "../../assets/marca/hero-cielo-desktop.jpg";
import Plane from "./Plane.astro";
import Cta from "./Cta.astro";
import Countdown from "./Countdown.astro";

const cieloM = await getImage({ src: cieloMobile, format: "webp", quality: 90 });
const cieloD = await getImage({ src: cieloDesktop, format: "webp", quality: 90 });
const fecha = fechaEvento(evento.fecha);
const chip =
  "bg-paper px-[11px] py-[7px] text-sm font-extrabold rounded-[9px] lg:rounded-[10px] lg:px-[15px] lg:py-[9px] lg:text-base lg:shadow-[0_4px_0_rgb(29_33_82/0.15)]";
const PATH_D = "M-40 866 C 260 886, 560 866, 760 786 S 1100 520, 1300 300 S 1440 160, 1500 100";
const PATH_M = "M-20 1000 C 100 1010, 220 990, 280 900 S 340 700, 420 640";
---

<section id="hero" class="relative z-[2] min-h-[1100px] scroll-mt-0 bg-[linear-gradient(180deg,#3B99D8_0%,#66B3EA_82%,#63A3E2_100%)] lg:h-[900px] lg:min-h-0 lg:bg-[linear-gradient(180deg,#3B99D8_0%,#66B3EA_87%,#64ABE0_100%)]" aria-labelledby="hero-title">
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <!-- cielo fotográfico visto desde el avión -->
    <div
      class="absolute inset-0 bg-cover bg-[position:50%_50%] bg-no-repeat [background-image:var(--cielo-m)] lg:bg-[position:50%_50%] lg:[background-image:var(--cielo-d)]"
      style={`--cielo-m:url(${cieloM.src});--cielo-d:url(${cieloD.src})`}
    ></div>
    <!-- velo azul suave: contraste para el título a la izquierda -->
    <div class="absolute inset-0 bg-[linear-gradient(180deg,rgb(47_134_196/0.55)_0%,rgb(47_134_196/0.42)_60%,rgb(47_134_196/0.28)_100%)] lg:bg-[linear-gradient(90deg,rgb(47_134_196/0.62)_0%,rgb(47_134_196/0.4)_45%,rgb(47_134_196/0.05)_85%)]"></div>

    <!-- estela y avión: móvil -->
    <svg class="absolute inset-0 size-full lg:hidden" viewBox="0 0 390 1100" preserveAspectRatio="xMidYMax slice">
      <path class="v-dash" d={PATH_M} fill="none" stroke="#FDFEFC" stroke-width="3" stroke-linecap="round" opacity=".85"></path>
      <g class="motion-plane">
        <Plane scale={2} rotate={90} stroke="#1D2152" strokeWidth={0.7} />
        <animateMotion dur="12s" repeatCount="indefinite" rotate="auto" path={PATH_M}></animateMotion>
      </g>
    </svg>
    <!-- estela y avión: escritorio -->
    <svg class="absolute inset-0 hidden size-full lg:block" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMax slice">
      <path class="v-dash" d={PATH_D} fill="none" stroke="#FDFEFC" stroke-width="4" stroke-linecap="round" opacity=".85"></path>
      <g class="motion-plane">
        <Plane scale={2.6} rotate={90} stroke="#1D2152" strokeWidth={0.6} />
        <animateMotion dur="14s" repeatCount="indefinite" rotate="auto" path={PATH_D}></animateMotion>
      </g>
    </svg>
  </div>

  <div class="relative mx-auto flex w-full max-w-[1200px] flex-col gap-[18px] px-5 pt-[100px] pb-28 lg:h-full md:px-8 lg:grid lg:grid-cols-[1.05fr_.95fr] lg:items-center lg:gap-14 lg:px-10 lg:pt-[150px] lg:pb-[100px] xl:px-0">
    <div class="flex flex-col gap-[18px] lg:gap-6">
      <h1 id="hero-title" class="m-0 font-display text-[clamp(3.5rem,16vw,4.125rem)] leading-[.96] font-normal text-paper [text-shadow:0_4px_0_rgb(29_33_82/0.22)] lg:text-[clamp(64px,7.1vw,100px)] lg:whitespace-nowrap lg:[text-shadow:0_6px_0_rgb(29_33_82/0.22)]">
        Study Abroad<br />
        <span class="mt-2.5 inline-block -rotate-[2.5deg] rounded-xl border-4 border-paper bg-brand-gradient px-[22px] pt-[3px] text-[42px] tracking-[.08em] shadow-[0_5px_0_rgb(29_33_82/0.16)] [text-shadow:none] lg:mt-3.5 lg:rounded-2xl lg:border-[6px] lg:px-9 lg:pt-1 lg:text-[clamp(46px,4.9vw,70px)] lg:shadow-[0_6px_0_rgb(29_33_82/0.16),0_14px_28px_-12px_rgb(29_33_82/0.35)]">FEST</span>
      </h1>

      <p class="m-0 max-w-[30ch] text-[19px] leading-[1.35] font-bold text-paper lg:text-2xl">
        Becas, intercambios y universidades del mundo en una sola tarde. Sal con tu siguiente paso claro.
      </p>

      <ul class="m-0 flex list-none flex-wrap gap-2 p-0 lg:gap-2.5">
        <li class={`${chip} -rotate-[1.2deg]`}><span class="text-violet">{fecha.corta}</span> {fecha.anio}</li>
        <li class={`${chip} rotate-1`}>{rangoHoras(evento.horaInicio, evento.horaFin)}</li>
        <li class={`${chip} -rotate-1`}>{evento.lugar}</li>
        <li class={`${chip} rotate-[1.2deg]`}>{evento.gratuito && <span class="text-violet">Gratis</span>}{evento.inscripcionPrevia && " con inscripción"}</li>
      </ul>

      <div class="mt-1 flex flex-col gap-3 lg:flex-row lg:flex-wrap lg:items-center lg:gap-3.5">
        <Cta href={lumaUrl("hero")} class="min-h-14 lg:whitespace-nowrap text-[21px] lg:min-h-0 lg:px-[30px] lg:pt-4 lg:pb-3.5 lg:text-[22px] lg:tracking-[.02em]">
          Inscríbete gratis
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"></path></svg>
        </Cta>
        <Cta href="#cronograma" variant="outline" class="min-h-[52px] lg:whitespace-nowrap text-base lg:min-h-0 lg:px-[22px] lg:py-3.5 lg:text-[17px]">Ver la ruta de vuelo</Cta>
      </div>
    </div>

    <div class="relative mt-[30px] w-[min(300px,100%)] self-center lg:mt-0 lg:w-[clamp(340px,36vw,460px)] lg:justify-self-center">
      <div class="v-float overflow-hidden rounded-[20px] border-8 border-paper bg-paper shadow-[0_6px_0_rgb(29_33_82/0.16),0_18px_32px_-12px_rgb(29_33_82/0.5)] lg:rounded-3xl lg:border-[10px] lg:shadow-[0_8px_0_rgb(29_33_82/0.16),0_24px_44px_-14px_rgb(29_33_82/0.5)]">
        <Image
          src={keyVisual}
          alt="Afiche oficial de Study Abroad Fest: estudiantes en ruta de viaje con la maleta del evento y monumentos internacionales"
          width={440}
          height={550}
          widths={[284, 440, 819]}
          sizes="(min-width: 1024px) 440px, 284px"
          class="block aspect-[819/1024] w-full object-cover"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <!-- sello postal giratorio -->
      <svg class="absolute -top-7 -right-3.5 size-24 drop-shadow-[0_4px_0_rgb(29_33_82/0.16)] lg:-top-[46px] lg:-right-11 lg:size-[150px] lg:drop-shadow-[0_6px_0_rgb(29_33_82/0.16)]" viewBox="0 0 150 150" aria-hidden="true">
        <circle cx="75" cy="75" r="72" fill="#FDFEFC"></circle>
        <g class="v-spin">
          <defs><path id="v-ring" d="M75 75 m-56 0 a56 56 0 1 1 112 0 a56 56 0 1 1 -112 0"></path></defs>
          <text font-family="IBM Plex Mono, monospace" font-size="11.5" font-weight="600" fill="#AC0BAD" letter-spacing="1.8"><textPath href="#v-ring">STUDY ABROAD FEST · LIMA · 10 OCT 2026 ·</textPath></text>
        </g>
        <circle cx="75" cy="75" r="38" fill="none" stroke="#AC0BAD" stroke-width="2"></circle>
        <g transform="translate(75 75)"><Plane scale={1.7} rotate={45} fill="#6258BB" /></g>
      </svg>

      <div class="absolute z-10 -bottom-[34px] -left-2.5 lg:-left-[38px]">
        <Countdown />
      </div>
    </div>
  </div>

  <!-- bancos de nubes de papel recortado -->
  <div class="pointer-events-none absolute inset-x-0 bottom-0 overflow-visible" aria-hidden="true">
    <svg class="absolute -bottom-[70px] left-0 h-[160px] w-full lg:hidden" viewBox="0 0 390 160" preserveAspectRatio="xMidYMax slice">
      <g class="v-drift-b" fill="#FDFEFC" opacity=".95"><circle cx="50" cy="110" r="34"></circle><circle cx="94" cy="94" r="44"></circle><circle cx="142" cy="112" r="32"></circle><rect x="16" y="110" width="160" height="34" rx="17"></rect><circle cx="280" cy="118" r="30"></circle><circle cx="322" cy="102" r="40"></circle><circle cx="366" cy="120" r="28"></circle><rect x="250" y="118" width="150" height="32" rx="16"></rect></g>
    </svg>
    <svg class="absolute -bottom-[90px] left-0 hidden h-[220px] w-full lg:block" viewBox="0 0 1440 220" preserveAspectRatio="xMidYMax slice">
      <g class="v-drift-b" fill="#FDFEFC" opacity=".95">
        <circle cx="120" cy="140" r="52"></circle><circle cx="188" cy="118" r="64"></circle><circle cx="262" cy="144" r="48"></circle><rect x="70" y="140" width="240" height="50" rx="25"></rect>
        <circle cx="640" cy="150" r="46"></circle><circle cx="702" cy="126" r="60"></circle><circle cx="776" cy="152" r="44"></circle><rect x="596" y="150" width="240" height="46" rx="23"></rect>
        <circle cx="1120" cy="146" r="50"></circle><circle cx="1188" cy="120" r="66"></circle><circle cx="1266" cy="148" r="48"></circle><rect x="1070" y="146" width="260" height="50" rx="25"></rect>
      </g>
      <g class="v-drift" fill="#CFE6F6" opacity=".9">
        <circle cx="400" cy="170" r="40"></circle><circle cx="456" cy="152" r="52"></circle><circle cx="516" cy="174" r="38"></circle><rect x="360" y="170" width="200" height="40" rx="20"></rect>
        <circle cx="930" cy="176" r="38"></circle><circle cx="984" cy="158" r="48"></circle><circle cx="1038" cy="178" r="36"></circle><rect x="892" y="176" width="190" height="38" rx="19"></rect>
      </g>
    </svg>
  </div>
</section>
