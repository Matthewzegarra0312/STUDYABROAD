---
// Hero (design/canvas/Main.dc.html desktop + Mobile.dc.html). El lugar,
// la fecha y la hora son los reales de src/data/evento.ts: el canvas
// todavía muestra el lugar/horario viejo como texto fijo, se ignora ese
// literal (ver instrucción de esta fase).
import { Image } from "astro:assets";
import evento from "../data/evento";
import keyVisual from "../assets/marca/key-visual.png";
import { lumaUrl } from "../lib/luma";
import { googleCalendarUrl } from "../lib/calendario";
import { formatoFechaCorta, formatoHora12 } from "../lib/fechas";
import Button from "./ui/Button.astro";
import Countdown from "./Countdown.astro";

const rangoHoras = `${formatoHora12(evento.horaInicio)} a ${formatoHora12(evento.horaFin)}`;
---

<section id="hero" class="relative overflow-hidden px-4 pb-16 pt-6 sm:px-8 lg:px-[120px] lg:pb-0 lg:pt-10">
  <div class="cloud-drift pointer-events-none absolute left-6 top-4 hidden h-9 w-[130px] rounded-full bg-paper/90 sm:block" aria-hidden="true"></div>
  <div class="cloud-drift-slow pointer-events-none absolute left-1/2 top-[420px] hidden h-9 w-[110px] rounded-full bg-paper/70 lg:block" aria-hidden="true"></div>

  <div class="grid items-center gap-10 lg:min-h-[640px] lg:grid-cols-[1.05fr_.95fr] lg:gap-16">
    <div class="relative flex flex-col gap-5 sm:gap-6">
      {/* bg-ink/35 (no /20) y text-xl (no text-lg): por debajo de eso el
         texto paper no llega a 4.5:1 sobre el celeste (Fase 6, revisión AA). */}
      <span class="inline-flex w-fit items-center gap-2.5 rounded-full bg-ink/35 px-4 py-2 font-mono text-[13px] font-semibold uppercase tracking-[.14em] text-paper">
        <span class="h-2.5 w-2.5 rounded-full bg-[#FFE36B]" aria-hidden="true"></span>
        Feria de oportunidades internacionales
      </span>

      <h1 class="m-0 font-display text-[52px] leading-[.98] text-paper [text-shadow:0_6px_0_rgba(29,33,82,.22)] sm:text-[72px] lg:text-[104px]">
        Study Abroad<br />
        <span class="mt-2 inline-block rounded-2xl border-[6px] border-paper bg-brand-gradient px-6 pb-1 pt-1 text-[36px] tracking-[.08em] text-paper shadow-[0_6px_0_rgba(29,33,82,.16),0_14px_28px_-12px_rgba(29,33,82,.35)] [text-shadow:none] sm:text-[48px] lg:text-[66px]">
          FEST
        </span>
      </h1>

      <p class="m-0 max-w-[30ch] text-xl font-bold leading-snug text-paper sm:text-2xl">
        Becas, intercambios y universidades del mundo en una sola tarde. Sal con tu siguiente paso claro.
      </p>

      <div class="flex flex-wrap gap-2.5">
        <span class="-rotate-[1.2deg] rounded-[10px] bg-paper px-3.5 py-2 text-sm font-extrabold shadow-[0_4px_0_rgba(29,33,82,.15)] sm:text-base">
          <span class="text-violet">{formatoFechaCorta(evento.fecha)}</span>
        </span>
        <span class="rotate-1 rounded-[10px] bg-paper px-3.5 py-2 text-sm font-extrabold shadow-[0_4px_0_rgba(29,33,82,.15)] sm:text-base">
          {rangoHoras}
        </span>
        <span class="-rotate-1 rounded-[10px] bg-paper px-3.5 py-2 text-sm font-extrabold shadow-[0_4px_0_rgba(29,33,82,.15)] sm:text-base">
          {evento.lugar}
        </span>
        <span class="rotate-[1.2deg] rounded-[10px] bg-paper px-3.5 py-2 text-sm font-extrabold shadow-[0_4px_0_rgba(29,33,82,.15)] sm:text-base">
          <span class="text-violet">Gratis</span> con inscripción
        </span>
      </div>

      <div class="mt-1.5 flex flex-wrap items-center gap-3.5">
        <Button href={lumaUrl("hero")} variant="gradient" size="lg">
          Inscríbete gratis
          <svg slot="icon-end" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h13M13 6l6 6-6 6"></path>
          </svg>
        </Button>
        <Button href={googleCalendarUrl()} external variant="outline" size="md">
          <svg slot="icon-start" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="5" width="18" height="16" rx="3"></rect>
            <path d="M3 10h18M8 3v4M16 3v4"></path>
          </svg>
          Agregar a mi calendario
        </Button>
      </div>
    </div>

    <div class="relative mx-auto w-full max-w-[360px] justify-self-center lg:max-w-[500px]">
      <div class="hero-float overflow-hidden rounded-3xl border-[8px] border-paper bg-paper shadow-[0_8px_0_rgba(29,33,82,.16),0_22px_40px_-14px_rgba(29,33,82,.45)] sm:border-[10px]">
        <Image
          src={keyVisual}
          alt="Key visual de Study Abroad Fest"
          width={560}
          height={700}
          class="block aspect-[819/1024] w-full object-cover"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="absolute -bottom-6 -left-4 sm:-bottom-8 sm:-left-8">
        <Countdown />
      </div>
    </div>
  </div>
</section>
