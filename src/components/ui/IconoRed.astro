---
// Icono de la red según la URL (misma lógica que etiquetaEnlace). Hereda el color con currentColor.
interface Props {
  url: string;
  class?: string;
}

const { url, class: clase } = Astro.props;
const host = new URL(url).hostname.replace(/^www\./, "");
const red = host === "instagram.com" ? "instagram" : host === "linkedin.com" ? "linkedin" : "web";
---

<svg class={clase} width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {red === "instagram" && (<><rect width="20" height="20" x="2" y="2" rx="5" ry="5" /><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37Z" /><path d="M17.5 6.5h.01" /></>)}
  {red === "linkedin" && (<><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6Z" /><path d="M2 9h4v12H2z" /><circle cx="4" cy="4" r="2" /></>)}
  {red === "web" && (<><circle cx="12" cy="12" r="10" /><path d="M2 12h20" /><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" /></>)}
</svg>
